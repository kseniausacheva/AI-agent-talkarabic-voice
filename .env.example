# Шаблон для docker-compose / Coolify. Скопируй в .env и заполни.
# В Coolify эти же переменные задаются через UI в разделе Environment Variables.

# ===== LLM =====
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=minimax/minimax-m3

# ===== Публичные URL =====
# Backend domain (например https://api.talkarabic.app)
BACKEND_PUBLIC_URL=https://api.example.com
# Frontend domain (например https://talkarabic.app)
FRONTEND_PUBLIC_URL=https://app.example.com

# ===== La Royal Event partner onboarding =====
# Keep closed until the final company details, privacy notice and portal domain
# have been reviewed. Add the portal origin to ALLOWED_ORIGINS before opening.
PARTNER_INTAKE_ENABLED=false
PARTNER_PRIVACY_NOTICE_VERSION=draft-2026-11-20
PARTNER_MARKETING_CONSENT_VERSION=marketing-v1
# Acceptance is intentionally fail-closed in this release; a checkbox does not
# replace the final agreement plus verified signer evidence workflow.
PARTNER_ACCEPTANCE_ENABLED=false
